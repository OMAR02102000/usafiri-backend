# Nakili file hili kuwa ".env" kisha ujaze thamani.

NODE_ENV=development
PORT=3000

# PostgreSQL
# Chaguo A (rahisi, salama kwa password yenye herufi maalum): sehemu tofauti
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=usafiri
# Chaguo B: URL moja (password yenye @ # / : % lazima ibadilishwe kuwa %40 %23 %2F %3A %25).
# Itumike tu kama DB_HOST haipo.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/usafiri
# true = jedwali linatengenezwa kiotomatiki (maendeleo tu). Uzalishaji: false na utumie migrations.
DB_SYNC=true

# Siri ya kusaini token (weka maneno marefu ya nasibu; usishiriki)
JWT_SECRET=badilisha-hii-kuwa-siri-ndefu
JWT_EXPIRES_IN=30d

# Admin wa kwanza (anatengenezwa mara ya kwanza backend inapoanza)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=badilisha-password-hii
ADMIN_NAME=Administrator

# Google Maps (hiari). Bila hii, umbali unakadiriwa kwa mstari wa moja kwa moja.
# Tumia key ya server, tofauti na key ya app ya simu.
GOOGLE_MAPS_API_KEY=

# Chanzo cha umbali: google | osrm | estimate.
#   osrm     = OpenStreetMap, umbali halisi wa barabara, bure na bila key (majaribio)
#   estimate = mstari wa moja kwa moja x 1.35
# Ikiachwa wazi: google kama key ipo, vinginevyo estimate.
ROUTING_PROVIDER=
# Seva ya OSRM. Ikiachwa wazi: https://router.project-osrm.org (ya majaribio tu).
# Kwa uzalishaji tumia seva yako mwenyewe.
OSRM_BASE_URL=

# Malipo / control number. Kwa sasa ni "mock" tu (control number za kuigiza).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=badilisha-siri-ya-webhook

# OTP: kwenye maendeleo, code inaandikwa kwenye console na kurudishwa kwenye jibu.
# Uzalishaji: unganisha mtoa huduma wa SMS (angalia src/auth/sms.service.ts).

# Hali ya majaribio ya seva ya wazi (mfano Railway): true = OTP inarudishwa kwenye jibu na malipo ni ya kuigiza.
# Tumia kwa data bandia tu. Kwa watumiaji halisi: iondoe na uunganishe SMS na mtoa huduma wa malipo.
DEMO_MODE=false
# true = tumia SSL kuunganisha na database (URL za umma za watoa huduma).
DB_SSL=false
