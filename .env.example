# Nakili file hili kuwa ".env" kisha ujaze thamani.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/usafiri
# true = jedwali linatengenezwa kiotomatiki (maendeleo tu). Uzalishaji: false na utumie migrations.
DB_SYNC=true

# Siri ya kusaini token (weka maneno marefu ya nasibu; usishiriki)
JWT_SECRET=badilisha-hii-kuwa-siri-ndefu
JWT_EXPIRES_IN=30d

# Admin wa kwanza (anatengenezwa mara ya kwanza backend inapoanza)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=badilisha-password-hii
ADMIN_NAME=Administrator

# Google Maps (hiari). Bila hii, umbali unakadiriwa kwa mstari wa moja kwa moja.
# Tumia key ya server, tofauti na key ya app ya simu.
GOOGLE_MAPS_API_KEY=

# Malipo / control number. Kwa sasa ni "mock" tu (control number za kuigiza).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=badilisha-siri-ya-webhook

# OTP: kwenye maendeleo, code inaandikwa kwenye console na kurudishwa kwenye jibu.
# Uzalishaji: unganisha mtoa huduma wa SMS (angalia src/auth/sms.service.ts).
